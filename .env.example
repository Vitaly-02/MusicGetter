# Local development only. Copy to .env; never use these credentials in production.
DATABASE_URL=postgres://musicgetter:musicgetter@127.0.0.1:5432/musicgetter?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_CONNECT_TIMEOUT=5s
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=5m
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=10s
HEALTH_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
MIGRATION_TIMEOUT=60s

# Compose publishes ports only on localhost. Keep DATABASE_URL in sync for make run.
POSTGRES_USER=musicgetter
POSTGRES_PASSWORD=musicgetter
POSTGRES_DB=musicgetter
POSTGRES_PORT=5432
BACKEND_PORT=8080
BACKEND_INTERNAL_PORT=8080

# Separate opt-in; integration tests create/drop random databases using this role.
# TEST_DATABASE_URL=postgres://musicgetter:musicgetter@127.0.0.1:5432/musicgetter?sslmode=disable

# Required only for cmd/bot; obtain from BotFather, never commit the real value.
TELEGRAM_BOT_TOKEN=

# Exact comma-separated extension origins; empty denies all Origin-bearing API requests.
EXTENSION_ORIGINS=
API_IP_PER_MINUTE=120
API_OWNER_PER_MINUTE=60
API_CLAIM_PER_MINUTE=5

# Import worker: per-process concurrent items, bounded retry and lease heartbeat
WORKER_CONCURRENCY=4
WORKER_LEASE=30s
WORKER_POLL_INTERVAL=1s
WORKER_JOB_TIMEOUT=2m
WORKER_RETRY_BASE=1s
WORKER_RETRY_MAX=5m

# Destination search: shared per-worker limits and bounded process-local cache
MATCHER_SEARCH_CONCURRENCY=4
MATCHER_SEARCH_TIMEOUT=10s
MATCHER_CACHE_TTL=5m
MATCHER_NEGATIVE_TTL=30s
MATCHER_CACHE_ENTRIES=512
MATCHER_CACHE_BYTES=16777216
